{
    "name": "laraxgram/apiserver",
    "description": "A Telegram Bot API server built on LaraGram MTProto.",
    "keywords": [
        "laragram",
        "apiserver",
        "telegram-bot-api",
        "bot",
        "telegram",
        "mtproto"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laraxgram/apiserver/issues",
        "source": "https://github.com/laraxgram/apiserver"
    },
    "authors": [
        {
            "name": "AmirHossein",
            "email": "isfahan@duck.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-swoole": "*",
        "ext-mbstring": "*",
        "laraxgram/core": "^4.5",
        "laraxgram/mtproto": "^0.4",
        "laraxgram/surge": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LaraGram\\Server\\": "src/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/laraxgram/apiserver/bin/generate"
        ],
        "post-update-cmd": [
            "@php vendor/laraxgram/apiserver/bin/generate"
        ],
        "post-root-package-install": [
            "@php vendor/laraxgram/apiserver/bin/generate"
        ],
        "post-create-project-cmd": [
            "@php vendor/laraxgram/apiserver/bin/generate"
        ]
    },
    "bin": [
        "bin/laragram-server"
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
